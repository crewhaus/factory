{
  "name": "crewhaus-factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Modular meta-harness tool: compiles a single high-level harness spec into multiple runtime targets",
  "workspaces": ["packages/*", "apps/*", "examples/*"],
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf packages/*/dist apps/*/dist examples/*/dist",
    "test": "bun --filter '@crewhaus/*' test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "compile:hello": "bun apps/cli/src/index.ts compile examples/hello-cli/crewhaus.yaml -o examples/hello-cli/dist",
    "run:hello": "bun examples/hello-cli/dist/agent.ts",
    "compile:hello-workflow": "bun apps/cli/src/index.ts compile examples/hello-workflow/crewhaus.yaml -o examples/hello-workflow/dist",
    "run:hello-workflow": "bun examples/hello-workflow/dist/agent.ts",
    "compile:mcp-smoke": "bun apps/cli/src/index.ts compile examples/mcp-smoke/crewhaus.yaml -o examples/mcp-smoke/dist",
    "run:mcp-smoke": "bun examples/mcp-smoke/dist/agent.ts",
    "compile:hello-channel": "bun apps/cli/src/index.ts compile examples/hello-channel/crewhaus.yaml -o examples/hello-channel/dist",
    "run:hello-channel": "bun examples/hello-channel/dist/daemon.ts",
    "smoke:section-11": "bun scripts/section-11-smoke.ts",
    "smoke:section-12": "bun scripts/section-12-smoke.ts",
    "smoke:section-13": "bun scripts/section-13-smoke.ts",
    "smoke:section-14": "bun scripts/section-14-smoke.ts",
    "compile:section-15-smoke": "bun apps/cli/src/index.ts compile examples/section-15-smoke/crewhaus.yaml -o examples/section-15-smoke/dist",
    "run:section-15-smoke": "bun examples/section-15-smoke/dist/agent.ts",
    "smoke:section-15": "bun scripts/section-15-smoke.ts",
    "compile:section-18-smoke": "bun apps/cli/src/index.ts compile examples/section-18-smoke/crewhaus.yaml -o examples/section-18-smoke/dist",
    "smoke:section-18": "bun scripts/section-18-smoke.ts",
    "compile:hello-graph": "bun apps/cli/src/index.ts compile examples/hello-graph/crewhaus.yaml -o examples/hello-graph/dist",
    "run:hello-graph": "bun examples/hello-graph/dist/agent.ts",
    "smoke:section-19": "bun scripts/section-19-smoke.ts",
    "compile:hello-managed": "bun apps/cli/src/index.ts compile examples/hello-managed/crewhaus.yaml -o examples/hello-managed/dist",
    "run:hello-managed": "bun examples/hello-managed/dist/daemon.ts",
    "smoke:section-20": "bun scripts/section-20-smoke.ts",
    "compile:hello-rag": "bun apps/cli/src/index.ts compile examples/hello-rag/crewhaus.yaml -o examples/hello-rag/dist",
    "run:hello-rag": "bun examples/hello-rag/dist/agent.ts",
    "smoke:section-21": "bun scripts/section-21-smoke.ts",
    "compile:hello-crew": "bun apps/cli/src/index.ts compile examples/hello-crew/crewhaus.yaml -o examples/hello-crew/dist",
    "run:hello-crew": "bun examples/hello-crew/dist/daemon.ts",
    "smoke:section-22": "bun scripts/section-22-smoke.ts",
    "compile:hello-research": "bun apps/cli/src/index.ts compile examples/hello-research/crewhaus.yaml -o examples/hello-research/dist",
    "run:hello-research": "bun examples/hello-research/dist/agent.ts",
    "smoke:section-23-res": "bun scripts/section-23-res-smoke.ts",
    "compile:hello-batch": "bun apps/cli/src/index.ts compile examples/hello-batch/crewhaus.yaml -o examples/hello-batch/dist",
    "run:hello-batch": "bun examples/hello-batch/dist/agent.ts",
    "smoke:section-23-batch": "bun scripts/section-23-batch-smoke.ts",
    "compile:hello-voice": "bun apps/cli/src/index.ts compile examples/hello-voice/crewhaus.yaml -o examples/hello-voice/dist",
    "smoke:section-24": "bun scripts/section-24-smoke.ts",
    "compile:hello-browser": "bun apps/cli/src/index.ts compile examples/hello-browser/crewhaus.yaml -o examples/hello-browser/dist",
    "smoke:section-25": "bun scripts/section-25-smoke.ts",
    "studio": "bun scripts/studio-launcher.ts",
    "smoke:section-26": "bun scripts/section-26-smoke.ts",
    "smoke:section-27": "bun examples/section-27-smoke/smoke.ts",
    "smoke:section-28": "bun examples/section-28-smoke/smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@crewhaus/studio-server": "workspace:*",
    "@crewhaus/studio-ui": "workspace:*",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "playwright": "1.59.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
