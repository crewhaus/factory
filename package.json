    "clean": "tsc -b --clean && rm -rf packages/*/dist apps/*/dist examples/*/dist",
    "test": "bun --filter '@crewhaus/*' test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "compile:hello": "bun apps/cli/src/index.ts compile examples/hello-cli/crewhaus.yaml -o examples/hello-cli/dist",
