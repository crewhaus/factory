# Copy this file to .env and fill in your value.
# Bun auto-loads .env on every `bun run` invocation; no dotenv loader needed.

# Option A: Claude subscription OAuth token (Pro/Max — recommended).
# Generate with: claude setup-token
# Tokens look like: sk-ant-oat01-...
ANTHROPIC_AUTH_TOKEN=

# Option B: Anthropic API key (pay-per-token).
# Get one from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Logging (optional). Default: pretty format, info level.
# CREWHAUS_LOG=json
# CREWHAUS_LOG_LEVEL=debug
