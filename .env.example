# Copy this file to .env and fill in the credential(s) for the provider(s) your
# spec uses. Bun auto-loads .env on every `bun run` invocation; no dotenv loader
# needed.
#
# The model-router lazy-loads adapters based on the spec's `model:` string. You
# only need credentials for the prefixes your spec actually references:
#
#   claude-…              → Anthropic
#   openai/…              → OpenAI (and OpenAI-compatible endpoints)
#   gemini/…              → Google Gemini (or Vertex AI via env flags)
#   bedrock/…             → AWS Bedrock (inference-profile ids supported)
#   local/<model>[@<url>] → any OpenAI-compatible local endpoint
#                           (defaults to Ollama at http://localhost:11434/v1)
#   groq/… together/… fireworks/… openrouter/… deepseek/… xai/… mistral/…
#   cerebras/…            → named OpenAI-compatible cloud hosts
#   azure/<deployment>    → Azure OpenAI
#   vertex/<model>        → Claude or Gemini on Google Vertex AI (ADC)
#
# Omitting credentials for providers you don't use is fine — adapters are not
# loaded unless their prefix is referenced. The full matrix lives in
# packages/model-router/README.md.

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Pick one: an OAuth token (Claude Pro/Max subscription, generated with
# `claude setup-token`) or an API key from console.anthropic.com/settings/keys.
# ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# Standard AWS credential chain (env vars, ~/.aws/credentials, IAM role), or a
# Bedrock API key. Region falls back to your AWS profile when unset.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Google Gemini ─────────────────────────────────────────────────────────────
# GEMINI_API_KEY also accepted as GOOGLE_API_KEY. For Vertex AI instead of the
# Gemini API: set GOOGLE_GENAI_USE_VERTEXAI=true (or just project + location
# with no API key) and authenticate with Application Default Credentials.
# GEMINI_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# ── Google Vertex AI (Claude) ─────────────────────────────────────────────────
# vertex/claude-* model strings; ADC auth. Project falls back to
# GOOGLE_CLOUD_PROJECT, region to GOOGLE_CLOUD_LOCATION (default us-east5).
# ANTHROPIC_VERTEX_PROJECT_ID=
# CLOUD_ML_REGION=us-east5

# ── OpenAI (and OpenAI-compatible endpoints) ──────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for proxies / local servers
# Note: `local/<model>@<url>` model strings reuse the OpenAI client against any
# OpenAI-compatible endpoint (Ollama, vLLM, llama.cpp, LM Studio). No key needed
# for loopback servers; a non-loopback local/ URL only ever receives
# CREWHAUS_LOCAL_API_KEY (never OPENAI_API_KEY).
# CREWHAUS_LOCAL_API_KEY=

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# azure/<deployment> model strings.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

# ── Named OpenAI-compatible cloud hosts ───────────────────────────────────────
# Each host prefix reads its own key — they never share OPENAI_API_KEY.
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=

# ── Logging (optional) ────────────────────────────────────────────────────────
# Default: pretty format, info level.
# CREWHAUS_LOG=json
# CREWHAUS_LOG_LEVEL=debug

# ── CLI experience (optional) ─────────────────────────────────────────────────
# Working-indicator spinner during silent waits (model thinking, tool runs,
# retry/compaction). Auto-on for an interactive REPL on a TTY; set to 0/false/
# off to disable, or force on with 1 (still TTY-gated). NO_COLOR → monochrome.
# CREWHAUS_SPINNER=0
# Render streamed model output as ANSI markdown (bold/headers/lists/code).
# CREWHAUS_CLI_MARKDOWN=1

# ── Slack channel target (only for live Slack integration) ────────────────────
# Required ONLY when running a real-Slack-workspace integration (i.e.
# `bun run run:hello-channel` pointed at a live Slack app's Event Subscription).
# NOT required for `bun run smoke:section-12`, which signs synthetic webhooks
# with its own test secret.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# SLACK_APP_TOKEN=xapp-...    # (optional, only for Socket Mode)
