# Copy this file to .env and fill in your value.
# Bun auto-loads .env on every `bun run` invocation; no dotenv loader needed.

# Option A: Claude subscription OAuth token (Pro/Max — recommended).
# Generate with: claude setup-token
# Tokens look like: sk-ant-oat01-...
ANTHROPIC_AUTH_TOKEN=

# Option B: Anthropic API key (pay-per-token).
# Get one from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Logging (optional). Default: pretty format, info level.
# CREWHAUS_LOG=json
# CREWHAUS_LOG_LEVEL=debug

# Section 12 — Slack channel target. Required ONLY when running a
# real-Slack-workspace integration (i.e. `bun run run:hello-channel`
# pointed at a live Slack app's Event Subscription). NOT required for
# `bun run smoke:section-12`, which signs synthetic webhooks with its
# own test secret.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# SLACK_APP_TOKEN=xapp-...    # (optional, only for Socket Mode)

# Section 17 — non-Anthropic model providers. Each is independent;
# include only the credentials matching the providers your spec uses
# (model strings: openai/<model>, gemini/<model>, bedrock/<modelId>,
# local/<model>@<url>). The model-router lazy-loads each adapter so
# omitting these does not break Anthropic-only paths.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for proxies / OpenAI-compatible local endpoints
# GEMINI_API_KEY=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
