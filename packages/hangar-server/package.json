{
  "name": "@crewhaus/hangar-server",
  "version": "0.8.2",
  "type": "module",
  "description": "The Hangar manager's local HTTP server: a loopback API every request reaches through one sign-in check over the machine-wide harness registry — fleet rows with cached rollups, per-harness detail/spec/preflight/sessions/evals/memory/cost views, registry CRUD, and the M2 driver surface (supervised process control, a live SSE run feed, crewhaus.control.v1 wake/drain, the approvals + review inboxes, an activity digest, and a job queue)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./eval-inputs": "./src/eval-inputs.ts",
    "./twin-sources": "./src/twin-sources.ts",
    "./scaffolded-workflows": "./src/scaffolded-workflows.ts",
    "./plugin-grants": "./src/plugin-grants.ts"
  },
  "scripts": {
    "test": "bun test src"
  },
